# ---------------------------------------------------------------------------
# NoBS Market — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Supabase (client-visible; safe to expose) -----------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- Supabase (server-only; used by server functions / SSR) ----------------
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_PROJECT_ID="your-project-ref"
# Bypasses Row Level Security. Server-side only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Stripe Connect (server-only) ------------------------------------------
# Either STRIPE_SECRET_KEY or STRIPE_TEST_API_KEY is used (in that order).
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_TEST_API_KEY=""
# From the Stripe dashboard webhook endpoint: POST /api/public/stripe-webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- EasyPost shipping (server-only) ---------------------------------------
EASYPOST_API_KEY="EZTK..."
